fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources-settings-mips-radialtext;resources-icons-19
fenix7pronowifi.resourcePath = $(fenix7pronowifi.resourcePath);resources-settings-mips-radialtext;resources-icons-19
