project.manifest = manifest.xml


# ------------------------------------------------------------------
# Per-Device Annotations
# ------------------------------------------------------------------

# Covers the rest of devices without Bitmap2 and without RadialText and >= CIQ v2
base.excludeAnnotations = hasBitmap2;ciq1;hasWatchFaceConfig

# Devices with Bitmap2 & Radial Text
epix2.excludeAnnotations = noBitmap2;ciq1;hasWatchFaceConfig
epix2pro42mm.excludeAnnotations = noBitmap2;ciq1;hasWatchFaceConfig
epix2pro47mm.excludeAnnotations = noBitmap2;ciq1;hasWatchFaceConfig
epix2pro51mm.excludeAnnotations = noBitmap2;ciq1;hasWatchFaceConfig

