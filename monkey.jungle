# ----
# MIPS devices with Bitmap2, but not radialText
# resources-settings-mips-bitmap2 + resources-icons-19
# 260x260
fr255.resourcePath = $(fr255.resourcePath);resources-settings-mips-bitmap2;resources-icons-19
fr255m.resourcePath = $(fr255m.resourcePath);resources-settings-mips-bitmap2;resources-icons-19
