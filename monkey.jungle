# CIQ v1 devices
fr45.excludeAnnotations = hasBitmap2;ciq2plus;hasWatchFaceConfig


# -------------------------------------------------------------
# Resource families
# -------------------------------------------------------------



# ----
# AMOLED devices (Uses default resources settings)
# 466x466
fenix9pro51mm.resourcePath = $(fenix9pro51mm.resourcePath);resources-icons-37
# 454x454
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-icons-37
fr57047mm.resourcePath = $(fr57047mm.resourcePath);resources-icons-37
