fr265s.resourcePath = $(fr265s.resourcePath);resources-icons-30



# ----
# AMOLED, but no support for radialtext
# 416x416
venu2.resourcePath = $(venu2.resourcePath);resources-settings-amoled-noradialtext;resources-icons-30
venu2plus.resourcePath = $(venu2plus.resourcePath);resources-settings-amoled-noradialtext;resources-icons-30
# 390x390
vivoactive5.resourcePath = $(vivoactive5.resourcePath);resources-settings-amoled-noradialtext;resources-icons-30
# 360x360
venu2s.resourcePath = $(venu2s.resourcePath);resources-settings-amoled-noradialtext;resources-icons-30


# ----
# AMOLED, but no support for Bitmap2 or radialtext
# 390x390
venu.resourcePath = $(venu.resourcePath);resources-settings-amoled-nobitmap2;resources-icons-30


# ----
# MIPS devices that have both Bitmap2 & radialText
# 280x280
fenix7x.resourcePath = $(fenix7x.resourcePath);resources-settings-mips-radialtext;resources-icons-19
fenix7xpro.resourcePath = $(fenix7xpro.resourcePath);resources-settings-mips-radialtext;resources-icons-19
fenix7xpronowifi.resourcePath = $(fenix7xpronowifi.resourcePath);resources-settings-mips-radialtext;resources-icons-19
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources-settings-mips-radialtext;resources-icons-19
fenix9prosolar51mm.resourcePath = $(fenix9prosolar51mm.resourcePath);resources-settings-mips-radialtext;resources-icons-19
