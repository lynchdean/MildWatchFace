# 390x390
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-icons-30
fr165.resourcePath = $(fr165.resourcePath);resources-icons-30
fr165m.resourcePath = $(fr165m.resourcePath);resources-icons-30
fr57042mm.resourcePath = $(fr57042mm.resourcePath);resources-icons-30
venu3s.resourcePath = $(venu3s.resourcePath);resources-icons-30
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-icons-30
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-icons-30
instinct3amoled45mm.resourcePath = $(instinct3amoled45mm.resourcePath);resources-icons-30
